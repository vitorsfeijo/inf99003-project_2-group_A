# ===========================================================================
# .gitignore — inf99003-project_2-group_A
# ===========================================================================

# ---------------------------------------------------------------------------
# PAPERS — PDFs de artigos (binários grandes, não versionados)
# ---------------------------------------------------------------------------
papers/*.pdf

# ---------------------------------------------------------------------------
# SLIDES — auxiliares do LaTeX (gerados na compilação)
# ---------------------------------------------------------------------------
slides/**/*.aux
slides/**/*.log
slides/**/*.nav
slides/**/*.out
slides/**/*.snm
slides/**/*.toc
slides/**/*.fdb_latexmk
slides/**/*.fls
slides/**/*.synctex.gz
# PNGs gerados pelo LaTeX (figs vetorizadas)
slides/**/figs/*.png
slides/**/_minted-*/

# ---------------------------------------------------------------------------
# PROJETO DE PESQUISA — PDFs de template (não versionados)
# ---------------------------------------------------------------------------
projeto_de_pesquisa/Estrutura de Projeto de Pesquisa.pdf
projeto_de_pesquisa/Guia_Template_Projeto.pdf
projeto_de_pesquisa.aux
projeto_de_pesquisa.log

# ---------------------------------------------------------------------------
# NODE.JS / MONOREPO
# ---------------------------------------------------------------------------
# Dependências instaladas (artefato + experimentos)
**/node_modules/

# Outputs de compilação TypeScript e Vite
**/dist/
**/.vite/
**/.turbo/
**/coverage/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# ARTEFATO — banco de dados SQLite (gerado em runtime, não versionado)
# ---------------------------------------------------------------------------
artefato/packages/server/data/*.db
artefato/packages/server/data/*.db-shm
artefato/packages/server/data/*.db-wal
/data/

# Mapa OSM baixado e índices OSRM gerados localmente
/osm-data/

# Exportações auxiliares do GeoSaúde: o KMZ completo (1) é a fonte versionada
/experimentos/dados/GEOSAUDE - Território Base (Jul25).kml
/experimentos/dados/GEOSAUDE - Território Base (Jul25).kmz

# ---------------------------------------------------------------------------
# EXPERIMENTOS — resultados de simulações (gerados em runtime)
# NOTA: experimentos/cenarios/*.json SÃO versionados (reprodutibilidade!)
# ---------------------------------------------------------------------------
experimentos/resultados/
experimentos/analise/relatorio_experimentos.html

# ---------------------------------------------------------------------------
# VARIÁVEIS DE AMBIENTE & EDITOR CACHES
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.eslintcache
.cache/
.parcel-cache/

# ---------------------------------------------------------------------------
# LOGS E TEMPORÁRIOS
# ---------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------------------
# SISTEMA OPERACIONAL
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
